{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "pdfstruct/raw_document.schema.json",
  "title": "PDFStruct raw document",
  "description": "Raw, non-semantic extraction of one PDF. Coordinates are points, origin top-left, page rotation applied.",
  "type": "object",
  "required": [
    "schema_version", "tool", "fingerprint", "source", "source_file", "extraction_method",
    "text_layer_score", "ocr_used", "coordinate_system", "page_count", "method_counts",
    "review_pages", "warnings", "pages"
  ],
  "properties": {
    "schema_version": { "const": "1.0" },
    "tool": {
      "type": "object",
      "required": ["name", "version"],
      "properties": { "name": { "type": "string" }, "version": { "type": "string" } }
    },
    "fingerprint": { "type": "string", "description": "Hash of source sha256 + extraction options; used for idempotent re-runs." },
    "source": {
      "type": "object",
      "required": ["path", "file_name", "sha256", "size_bytes"],
      "properties": {
        "path": { "type": "string" },
        "file_name": { "type": "string" },
        "sha256": { "type": "string", "pattern": "^[0-9a-f]{64}$" },
        "size_bytes": { "type": "integer", "minimum": 0 }
      }
    },
    "source_file": { "type": "string" },
    "extraction_method": { "enum": ["native", "ocr", "mixed", "none"] },
    "text_layer_score": { "type": ["number", "null"], "minimum": 0, "maximum": 1, "description": "Mean page score over non-blank pages; null if every page is blank." },
    "ocr_used": { "type": "boolean" },
    "ocr_engine": { "type": ["object", "null"] },
    "coordinate_system": { "type": "object" },
    "page_count": { "type": "integer", "minimum": 0 },
    "method_counts": {
      "type": "object",
      "required": ["native", "ocr", "none", "error"],
      "additionalProperties": { "type": "integer", "minimum": 0 }
    },
    "review_pages": { "type": "array", "items": { "type": "integer", "minimum": 1 } },
    "warnings": { "type": "array", "items": { "type": "string" } },
    "pages": { "type": "array", "items": { "$ref": "#/$defs/page" } }
  },
  "$defs": {
    "page": {
      "type": "object",
      "required": ["page", "width", "height", "rotation", "method", "text_layer", "ocr_confidence", "needs_review", "warnings", "text", "blocks"],
      "properties": {
        "page": { "type": "integer", "minimum": 1 },
        "width": { "type": ["number", "null"] },
        "height": { "type": ["number", "null"] },
        "rotation": { "type": ["integer", "null"] },
        "method": { "enum": ["native", "ocr", "none", "error"], "description": "none = page has no text (blank, or text layer empty and OCR not run/empty)." },
        "text_layer": {
          "type": ["object", "null"],
          "description": "Quality of the native text layer, measured before any OCR decision.",
          "required": ["score", "components", "chars", "bad_char_ratio", "block_count", "valid_bbox_ratio", "image_coverage", "object_count", "blank"],
          "properties": {
            "score": { "type": ["number", "null"], "minimum": 0, "maximum": 1 },
            "components": {
              "type": ["object", "null"],
              "properties": {
                "density": { "type": "number" },
                "unicode": { "type": "number" },
                "bbox": { "type": "number" }
              }
            },
            "chars": { "type": "integer", "minimum": 0 },
            "bad_char_ratio": { "type": "number", "minimum": 0, "maximum": 1 },
            "block_count": { "type": "integer", "minimum": 0 },
            "valid_bbox_ratio": { "type": "number", "minimum": 0, "maximum": 1 },
            "image_coverage": { "type": "number", "minimum": 0, "maximum": 1 },
            "object_count": { "type": "integer", "minimum": 0 },
            "blank": { "type": "boolean" }
          }
        },
        "ocr_confidence": { "type": ["number", "null"] },
        "needs_review": { "type": "boolean" },
        "warnings": { "type": "array", "items": { "type": "string" } },
        "text": { "type": "string" },
        "blocks": { "type": "array", "items": { "$ref": "#/$defs/block" } }
      }
    },
    "block": {
      "type": "object",
      "description": "Line-level text segment in extraction order.",
      "required": ["text", "bbox", "order"],
      "properties": {
        "text": { "type": "string" },
        "bbox": { "type": "array", "items": { "type": "number" }, "minItems": 4, "maxItems": 4 },
        "order": { "type": "integer", "minimum": 0 },
        "confidence": { "type": "number", "description": "OCR blocks only." }
      }
    }
  }
}
